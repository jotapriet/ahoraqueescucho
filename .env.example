NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternativa moderna a ANON_KEY; basta configurar una de las dos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origen de la app para enlaces de acceso. En desarrollo puede inferirse del navegador.
# Debe estar autorizado en Supabase Auth > URL Configuration.
APP_URL=
# Exclusivamente servidor. Nunca usar prefijo NEXT_PUBLIC_ para estos secretos.
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa moderna para el cliente privado; basta una de las dos.
SUPABASE_SECRET_KEY=
# Catálogo inicial: deezer (por defecto), musicbrainz o spotify. Deezer y MusicBrainz siempre disponibles.
MUSIC_CATALOG_PROVIDER=deezer
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
ODESLI_API_KEY=
